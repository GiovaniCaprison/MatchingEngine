<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema byteOrder="littleEndian" description="Matching engine canonical commands and events" id="1" package="io.github.giovanicaprison.matching.protocol" semanticVersion="0.1" version="0" xmlns:sbe="http://fixprotocol.io/2016/sbe">
  <!--
    The engine's wire format. Commands in, events out.

    This is an internal canonical format, not a client facing protocol. A client protocol carries
    hundreds of fields, optional groups and session plumbing; a canonical command is about ten fields
    wide. See docs/PROTOCOL.md for what the messages mean and docs/SCOPE.md for why the engine sees
    this rather than a session protocol.

    Adding a field or a message means a version bump, not a new schema. Existing decoders keep working,
    which is what leaves room for session state and auctions without a format change.
  -->
  <types>
    <composite description="Template and schema identification" name="messageHeader">
      <type name="blockLength" primitiveType="uint16"></type>
      <type name="templateId" primitiveType="uint16"></type>
      <type name="schemaId" primitiveType="uint16"></type>
      <type name="version" primitiveType="uint16"></type>
    </composite>
    <composite description="Carried by every command" name="CommandFrame">
      <type name="instrumentId" primitiveType="uint32"></type>
      <!-- Assigned upstream. The engine consumes this order rather than imposing it. -->
      <type name="sequence" primitiveType="uint64"></type>
    </composite>
    <composite description="Carried by every event" name="EventFrame">
      <type name="instrumentId" primitiveType="uint32"></type>
      <!-- The engine's own output numbering. -->
      <type name="sequence" primitiveType="uint64"></type>
      <!-- The command that caused this event, so causality is in the data. -->
      <type name="causeSequence" primitiveType="uint64"></type>
    </composite>
    <enum encodingType="uint8" name="Side">
      <validValue name="BUY">0</validValue>
      <validValue name="SELL">1</validValue>
    </enum>
    <enum encodingType="uint8" name="PricingInstruction">
      <validValue name="LIMIT">0</validValue>
      <validValue name="MARKET">1</validValue>
    </enum>
    <enum encodingType="uint8" name="TimeInForce">
      <validValue name="GOOD_TILL_CANCEL">0</validValue>
      <validValue name="DAY">1</validValue>
      <validValue name="IMMEDIATE_OR_CANCEL">2</validValue>
      <validValue name="FILL_OR_KILL">3</validValue>
    </enum>
    <set encodingType="uint8" name="OrderFlags">
      <choice name="postOnly">0</choice>
    </set>
    <enum encodingType="uint8" name="RejectReason">
      <validValue name="NON_POSITIVE_QUANTITY">0</validValue>
      <validValue name="LOT_VIOLATION">1</validValue>
      <validValue name="NON_POSITIVE_PRICE">2</validValue>
      <validValue name="TICK_VIOLATION">3</validValue>
      <validValue name="BAND_VIOLATION">4</validValue>
      <validValue name="INVALID_FIELDS">5</validValue>
      <validValue name="WOULD_CROSS">6</validValue>
      <validValue name="FILL_OR_KILL_UNFILLABLE">7</validValue>
      <validValue name="UNKNOWN_ORDER">8</validValue>
    </enum>
    <enum encodingType="uint8" name="RemoveReason">
      <validValue name="CANCELLED">0</validValue>
      <validValue name="REPLACED">1</validValue>
      <validValue name="IMMEDIATE_OR_CANCEL_REMAINDER">2</validValue>
      <validValue name="FILL_OR_KILL_KILLED">3</validValue>
    </enum>
  </types>
  <sbe:message description="Place an order" id="1" name="NewOrder">
    <field id="1" name="frame" type="CommandFrame"></field>
    <field id="2" name="clientOrderId" type="uint64"></field>
    <field id="3" name="participantId" type="uint32"></field>
    <field id="4" name="side" type="Side"></field>
    <field id="5" name="pricing" type="PricingInstruction"></field>
    <field id="6" name="timeInForce" type="TimeInForce"></field>
    <field id="7" name="flags" type="OrderFlags"></field>
    <!-- Scaled integer. Ignored when pricing is MARKET. -->
    <field id="8" name="price" type="int64"></field>
    <field id="9" name="quantity" type="int64"></field>
  </sbe:message>
  <sbe:message description="Cancel a resting order" id="2" name="CancelOrder">
    <field id="1" name="frame" type="CommandFrame"></field>
    <field id="2" name="clientOrderId" type="uint64"></field>
    <field id="3" name="participantId" type="uint32"></field>
    <field id="4" name="orderId" type="uint64"></field>
  </sbe:message>
  <sbe:message description="Replace a resting order, carrying full intent" id="3" name="ReplaceOrder">
    <field id="1" name="frame" type="CommandFrame"></field>
    <field id="2" name="clientOrderId" type="uint64"></field>
    <field id="3" name="participantId" type="uint32"></field>
    <field id="4" name="orderId" type="uint64"></field>
    <field id="5" name="quantity" type="int64"></field>
    <field id="6" name="price" type="int64"></field>
  </sbe:message>
  <sbe:message description="Admitted, with its engine order id" id="10" name="OrderAccepted">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="orderId" type="uint64"></field>
    <field id="3" name="clientOrderId" type="uint64"></field>
    <field id="4" name="participantId" type="uint32"></field>
  </sbe:message>
  <sbe:message description="Refused, and no state changed" id="11" name="OrderRejected">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="clientOrderId" type="uint64"></field>
    <field id="3" name="participantId" type="uint32"></field>
    <field id="4" name="reason" type="RejectReason"></field>
  </sbe:message>
  <sbe:message description="Entered the book: the feed's add order" id="12" name="OrderRested">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="orderId" type="uint64"></field>
    <field id="3" name="side" type="Side"></field>
    <field id="4" name="price" type="int64"></field>
    <field id="5" name="quantity" type="int64"></field>
  </sbe:message>
  <sbe:message description="One execution, at the resting order's price" id="13" name="OrderExecuted">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="executionId" type="uint64"></field>
    <field id="3" name="aggressorOrderId" type="uint64"></field>
    <field id="4" name="restingOrderId" type="uint64"></field>
    <field id="5" name="price" type="int64"></field>
    <field id="6" name="quantity" type="int64"></field>
  </sbe:message>
  <sbe:message description="New resting quantity, queue position kept" id="14" name="OrderReduced">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="orderId" type="uint64"></field>
    <field id="3" name="quantity" type="int64"></field>
  </sbe:message>
  <sbe:message description="Left the book, with the quantity removed" id="15" name="OrderRemoved">
    <field id="1" name="frame" type="EventFrame"></field>
    <field id="2" name="orderId" type="uint64"></field>
    <field id="3" name="quantity" type="int64"></field>
    <field id="4" name="reason" type="RemoveReason"></field>
  </sbe:message>
</sbe:messageSchema>
