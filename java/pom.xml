<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.giovanicaprison</groupId>
  <artifactId>matching-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sbe.version>1.34.1</sbe.version>
    <agrona.version>2.2.1</agrona.version>
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <hdrhistogram.version>2.2.2</hdrhistogram.version>
    <exec.plugin.version>3.5.0</exec.plugin.version>
    <buildhelper.plugin.version>3.6.0</buildhelper.plugin.version>
    <surefire.version>3.5.1</surefire.version>
    <shade.plugin.version>3.6.0</shade.plugin.version>
    <spotless.version>3.10.0</spotless.version>
    <githook.plugin.version>3.6.0</githook.plugin.version>
    <googlejavaformat.version>1.35.0</googlejavaformat.version>
    <jvm.access.flags>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED --enable-native-access=ALL-UNNAMED</jvm.access.flags>
  </properties>
  <!-- Rungs land one at a time: indexed, pooled, flyweight. -->
  <modules>
    <module>matching-protocol</module>
    <module>matching-api</module>
    <module>matching-flow</module>
    <module>matching-conformance</module>
    <module>matching-gates</module>
    <module>matching-naive</module>
    <module>matching-indexed</module>
    <module>matching-lean-naive</module>
    <module>matching-lean-indexed</module>
    <module>matching-pooled</module>
    <module>matching-lean-pooled</module>
    <module>matching-flyweight</module>
    <module>matching-calibration</module>
    <module>matching-benchmarks</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.agrona</groupId>
        <artifactId>agrona</artifactId>
        <version>${agrona.version}</version>
      </dependency>
      <dependency>
        <groupId>uk.co.real-logic</groupId>
        <artifactId>sbe-tool</artifactId>
        <version>${sbe.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-flow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-conformance</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-naive</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-lean-naive</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-indexed</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-lean-indexed</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-pooled</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-lean-pooled</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.giovanicaprison</groupId>
        <artifactId>matching-flyweight</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.hdrhistogram</groupId>
        <artifactId>HdrHistogram</artifactId>
        <version>${hdrhistogram.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <!--
              Two flags every module inherits. Agrona reaches jdk.internal.misc.Unsafe for buffer
              access, which the module system does not export by default. And the harness calls
              sched_setaffinity and perf_event_open through the foreign function API, which warns
              today and will be blocked outright without native access enabled.
            -->
            <argLine>${jvm.access.flags}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!--
          Points git at the committed hooks on the first build, so formatting-on-commit installs
          itself for anyone who builds. Git never activates hooks from a clone on its own, which is
          a security decision and not an omission, so some build has to do this once.
        -->
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>${githook.plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <gitConfig>
            <core.hooksPath>hooks</core.hooksPath>
          </gitConfig>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <!--
              The same formatter the editors run, pinned to the version the tree is formatted
              with. It takes no configuration, which is the point: there is no options file to
              drift, so pinning the version pins the format. The formatter reaches javac's
              internals, which is what .mvn/jvm.config opens for it. Removing unused imports is
              a separate step because the formatter deliberately leaves them alone, and a deleted
              method's imports should go with it.
            -->
            <removeUnusedImports/>
            <googleJavaFormat>
              <version>${googlejavaformat.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <!-- verify rather than test, so the development loop stays fast and nothing lands
                 unformatted. spotless:apply fixes what check refuses. -->
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
