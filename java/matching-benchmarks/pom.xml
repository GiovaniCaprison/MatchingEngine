<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.giovanicaprison</groupId>
    <artifactId>matching-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>matching-benchmarks</artifactId>
  <description>The measurement harness: what a run records, and the environment it refuses to run in.</description>
  <dependencies>
    <!--
      The flow, for the parameters a manifest has to carry, and the api and protocol for the events a
      run verifies. No implementation: a measurement names one on its command line.
    -->
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-flow</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
    </dependency>
    <!--
      Every rung, at runtime only. The harness names an implementation on its command line and
      constructs it by reflection, so nothing here compiles against one, and one process still runs
      exactly one engine.
    -->
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-naive</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-lean-naive</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-indexed</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.giovanicaprison</groupId>
      <artifactId>matching-lean-indexed</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The histogram is an output format here, produced after a run from the timings it kept. -->
    <dependency>
      <groupId>org.hdrhistogram</groupId>
      <artifactId>HdrHistogram</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <!-- A reduced pom is a generated file in the source tree, and it gets committed. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.giovanicaprison.matching.benchmarks.Runner</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
